[Unit]
Description=F1 25 Race Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=diego
Group=diego
WorkingDirectory=/home/diego/Documents/racecompanion
Environment=NODE_ENV=production
Environment=PORT=3469
Environment=UDP_PORT=20777
ExecStart=/usr/bin/node dist-server/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/diego/Documents/racecompanion/data
UMask=0027

[Install]
WantedBy=multi-user.target
